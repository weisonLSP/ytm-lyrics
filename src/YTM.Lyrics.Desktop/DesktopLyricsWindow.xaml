<Window x:Class="YTM.Lyrics.Desktop.DesktopLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTM.Lyrics 桌面歌词"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MinWidth="200" MinHeight="60"
        Opacity="{Binding Settings.desktop_opacity, Mode=TwoWay}"
        MouseLeftButtonDown="OnMouseLeftButtonDown">

    <!-- TASK-301 窗口壳：透明无边框（窗口本体），可见外壳为暗色圆角面板。
         位置/尺寸/置顶/穿透在 code-behind 按 settings 应用。 -->
    <Grid>
        <!-- 可见外壳：歌词渲染层 + 占位层（互斥切换）+ 右键菜单（逃生口，UI_SPEC §3.2/§5.2） -->
        <Border x:Name="Shell" CornerRadius="10" Background="#D9151720"
                BorderBrush="#553C3F55" BorderThickness="1" Padding="16,10">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MiClickThrough" Header="点击穿透" IsCheckable="True" Click="OnToggleClickThrough" />
                    <MenuItem x:Name="MiLocked" Header="锁定位置" IsCheckable="True" Click="OnToggleLocked" />
                    <MenuItem x:Name="MiTopmost" Header="置顶" IsCheckable="True" Click="OnToggleTopmost" />
                    <Separator />
                    <MenuItem Header="重置窗口位置" Click="OnResetPosition" />
                    <MenuItem Header="隐藏桌面歌词" Click="OnHideWindow" />
                </ContextMenu>
            </Border.ContextMenu>

            <!-- 双态互斥：占位层（无播放=品牌 / 加载中 / 暂无歌词）↔ 歌词层（TASK-302 渲染） -->
            <Grid>
                <!-- 占位：无播放=品牌；加载中；无歌词=暂无歌词（hide 模式下直接隐藏窗口） -->
                <TextBlock x:Name="PlaceholderText" Text="🎵 YTM.Lyrics 桌面歌词"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="26" Foreground="#EDEDF2"
                           TextTrimming="CharacterEllipsis" />

                <!-- 歌词渲染层（TASK-302）：Canvas 精确控制行 Y 位置（换行动画动画 TranslateTransform.Y），
                     ClipToBounds 防动画溢出。Z 序：下一行(底) → 旧行淡出(中) → 当前行(顶)。
                     行宽 = Canvas 宽 + TextAlignment=Center 实现水平居中（Canvas 内 HorizontalAlignment 无效）。
                     NextLineText Opacity=0.55：渐隐是静态样式（UI_SPEC §2.1 初值，M3 微调），不做动画。 -->
                <!-- 歌词渲染层（TASK-302）：Canvas 精确控制行 Y 位置，ClipToBounds 防溢出。
                     Z 序：下一行(底) → 当前行(顶)。行宽 = Canvas 宽 + TextAlignment=Center。
                     换行动画 v1 为硬切（Lyricify 4 实测校准），无过渡动画。 -->
                <Canvas x:Name="LyricsCanvas" ClipToBounds="True" Visibility="Collapsed">
                    <TextBlock x:Name="NextLineText" TextAlignment="Center"
                               TextWrapping="NoWrap" Opacity="0.55" />
                    <TextBlock x:Name="CurrentLineText" TextAlignment="Center"
                               TextWrapping="NoWrap" />
                </Canvas>
            </Grid>
        </Border>

        <!-- 缩放手柄层：3x3 网格，四边 8px + 四角（Thumb 需 Transparent 背景才参与命中测试；
             中间单元格无子元素、网格无背景 → 点击穿透到外壳 Border）。锁定后由 code-behind 忽略。 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
            </Grid.RowDefinitions>

            <Thumb x:Name="ResizeTopLeft" Grid.Row="0" Grid.Column="0" Background="Transparent" Cursor="SizeNWSE" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeTop" Grid.Row="0" Grid.Column="1" Background="Transparent" Cursor="SizeNS" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeTopRight" Grid.Row="0" Grid.Column="2" Background="Transparent" Cursor="SizeNESW" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeLeft" Grid.Row="1" Grid.Column="0" Background="Transparent" Cursor="SizeWE" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeRight" Grid.Row="1" Grid.Column="2" Background="Transparent" Cursor="SizeWE" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeBottomLeft" Grid.Row="2" Grid.Column="0" Background="Transparent" Cursor="SizeNESW" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeBottom" Grid.Row="2" Grid.Column="1" Background="Transparent" Cursor="SizeNS" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeBottomRight" Grid.Row="2" Grid.Column="2" Background="Transparent" Cursor="SizeNWSE" DragDelta="OnResizeDrag" />
        </Grid>
    </Grid>
</Window>
