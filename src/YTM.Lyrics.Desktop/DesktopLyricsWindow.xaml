<Window x:Class="YTM.Lyrics.Desktop.DesktopLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTM.Lyrics 桌面歌词"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MinWidth="200" MinHeight="60"
        Opacity="{Binding Settings.desktop_opacity, Mode=TwoWay}"
        MouseLeftButtonDown="OnMouseLeftButtonDown">

    <!-- 透明缩放手柄样式：覆盖 Thumb 默认模板（Aero2 主题下默认有白色边框/方块视觉），
         改为完全透明无感手柄，仅保留命中区域与 DragDelta 缩放功能。 -->
    <Window.Resources>
        <Style x:Key="InvisibleResizeThumb" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- TASK-301 窗口壳：透明无边框（窗口本体），可见外壳为暗色圆角面板。
         位置/尺寸/置顶/穿透在 code-behind 按 settings 应用。 -->
    <Grid>
        <!-- 外壳：默认近乎透明（alpha=1 保证接收鼠标）；悬停时显示半透明深色底，离开恢复透明。
             无圆角、无边框，消除浅色桌面上的边缘描边。 -->
        <Border x:Name="Shell" Background="#01151720"
                BorderThickness="0" Padding="16,10"
                MouseEnter="OnShellMouseEnter" MouseLeave="OnShellMouseLeave">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MiClickThrough" Header="点击穿透" IsCheckable="True" Click="OnToggleClickThrough" />
                    <MenuItem x:Name="MiLocked" Header="锁定位置" IsCheckable="True" Click="OnToggleLocked" />
                    <MenuItem x:Name="MiTopmost" Header="置顶" IsCheckable="True" Click="OnToggleTopmost" />
                    <Separator />
                    <MenuItem Header="重置窗口位置" Click="OnResetPosition" />
                    <MenuItem Header="隐藏桌面歌词" Click="OnHideWindow" />
                </ContextMenu>
            </Border.ContextMenu>

            <!-- 双态互斥：占位层（无播放=品牌 / 加载中 / 暂无歌词）↔ 歌词层（TASK-302 渲染） -->
            <Grid>
                <!-- 占位：无播放=品牌；加载中；无歌词=暂无歌词（hide 模式下直接隐藏窗口） -->
                <TextBlock x:Name="PlaceholderText" Text="🎵 YTM.Lyrics 桌面歌词"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="26" Foreground="#EDEDF2"
                           TextTrimming="CharacterEllipsis" />

                <!-- 歌词渲染层：Viewbox 等比缩放（Stretch=Uniform 绝不截断），内层固定设计尺寸 Grid
                     + StackPanel 垂直居中。行序：当前原词 → 当前译词 → 下一句原词 → 下一句译词。
                     未唱句白色预载，当前句绿色高亮（颜色切换，非文本突现）。 -->
                <Viewbox x:Name="LyricsViewbox" Stretch="Uniform" Visibility="Collapsed">
                    <Grid Width="600" Height="140">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentLineText" TextAlignment="Center" TextWrapping="NoWrap" />
                            <TextBlock x:Name="CurrentTranslationText" TextAlignment="Center" TextWrapping="Wrap"
                                       Visibility="Collapsed" Margin="0,4,0,0" />
                            <TextBlock x:Name="NextLineText" TextAlignment="Center" TextWrapping="NoWrap"
                                       Margin="0,12,0,0" />
                            <TextBlock x:Name="NextTranslationText" TextAlignment="Center" TextWrapping="Wrap"
                                       Visibility="Collapsed" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <!-- 缩放手柄层：3x3 网格，四边 8px + 四角（Thumb 需 Transparent 背景才参与命中测试；
             中间单元格无子元素、网格无背景 → 点击穿透到外壳 Border）。锁定后由 code-behind 忽略。 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
            </Grid.RowDefinitions>

            <Thumb x:Name="ResizeTopLeft" Grid.Row="0" Grid.Column="0" Style="{StaticResource InvisibleResizeThumb}" Cursor="SizeNWSE" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeTop" Grid.Row="0" Grid.Column="1" Style="{StaticResource InvisibleResizeThumb}" Cursor="SizeNS" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeTopRight" Grid.Row="0" Grid.Column="2" Style="{StaticResource InvisibleResizeThumb}" Cursor="SizeNESW" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeLeft" Grid.Row="1" Grid.Column="0" Style="{StaticResource InvisibleResizeThumb}" Cursor="SizeWE" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeRight" Grid.Row="1" Grid.Column="2" Style="{StaticResource InvisibleResizeThumb}" Cursor="SizeWE" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeBottomLeft" Grid.Row="2" Grid.Column="0" Style="{StaticResource InvisibleResizeThumb}" Cursor="SizeNESW" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeBottom" Grid.Row="2" Grid.Column="1" Style="{StaticResource InvisibleResizeThumb}" Cursor="SizeNS" DragDelta="OnResizeDrag" />
            <Thumb x:Name="ResizeBottomRight" Grid.Row="2" Grid.Column="2" Style="{StaticResource InvisibleResizeThumb}" Cursor="SizeNWSE" DragDelta="OnResizeDrag" />
        </Grid>
    </Grid>
</Window>
