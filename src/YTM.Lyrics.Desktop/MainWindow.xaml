<Window x:Class="YTM.Lyrics.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTM.Lyrics — M2 歌词面板"
        Height="760" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="#1B1D29">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 连接状态 -->
            <RowDefinition Height="Auto" /> <!-- 标题 -->
            <RowDefinition Height="Auto" /> <!-- 艺人 -->
            <RowDefinition Height="Auto" /> <!-- 进度 -->
            <RowDefinition Height="Auto" /> <!-- 播放状态 -->
            <RowDefinition Height="Auto" /> <!-- 歌词状态（加载中/暂无歌词/低置信提示） -->
            <RowDefinition Height="*" />   <!-- 歌词滚动列表 -->
            <RowDefinition Height="Auto" /> <!-- 底部来源与置信度 + 解除绑定 -->
            <RowDefinition Height="Auto" /> <!-- F9 手动搜索面板（默认隐藏） -->
        </Grid.RowDefinitions>

        <!-- 连接状态指示 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Ellipse x:Name="ConnDot" Width="10" Height="10" Fill="#8A8A96"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="ConnText" Text="等待探针连接…"
                       Foreground="#9A9AA6" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 原始元数据：标题 -->
        <TextBlock x:Name="TitleText" Grid.Row="1" Margin="0,22,0,0"
                   Text="—" FontSize="26" FontWeight="SemiBold"
                   Foreground="#EDEDF2" TextTrimming="CharacterEllipsis" />

        <!-- 原始元数据：艺人 -->
        <TextBlock x:Name="ArtistText" Grid.Row="2" Margin="0,6,0,0"
                   Text="—" FontSize="16"
                   Foreground="#B4B4C2" TextTrimming="CharacterEllipsis" />

        <!-- 实时进度（GetInterpolatedPosition 驱动，200ms 一档） -->
        <TextBlock x:Name="ProgressText" Grid.Row="3" Margin="0,22,0,0"
                   Text="--:-- / --:--" FontSize="20"
                   FontFamily="Consolas" Foreground="#8FD6B6" />

        <!-- 播放状态 -->
        <TextBlock x:Name="StateText" Grid.Row="4" Margin="0,16,0,0"
                   Text="等待数据" FontSize="15" FontWeight="Bold" Foreground="#9A9AA6" />

        <!-- 歌词状态条：加载中 / 暂无歌词 / 低置信提示（有歌词时置空） -->
        <TextBlock x:Name="LyricsStatusText" Grid.Row="5" Margin="0,18,0,0"
                   Text="等待播放…" FontSize="16" FontWeight="SemiBold"
                   Foreground="#9A9AA6" />

        <!-- 歌词滚动列表：整首歌词纯文本，当前行高亮放大（1.15x），40% 视口定位 -->
        <Border Grid.Row="6" Margin="0,10,0,0"
                Background="#12141D" CornerRadius="8" Padding="16,12,16,12">
            <ScrollViewer x:Name="LyricsScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="LyricsPanel" />
            </ScrollViewer>
        </Border>

        <!-- 底部来源与置信度（TDD §3.3：Low 明确提示"低置信结果"；F9 绑定结果旁提供解除绑定入口；
             TASK-402 设置按钮；TASK-503 常驻"搜索歌词"入口） -->
        <Grid Grid.Row="7" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SourceBarText" Grid.Column="0"
                       Text="" FontSize="13" Foreground="#7C7C8A"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button x:Name="UnbindButton" Grid.Column="1" Content="解除绑定"
                    Visibility="Collapsed" Margin="12,0,0,0" Padding="10,4"
                    FontSize="12" Click="OnUnbindClicked" />
            <!-- TASK-503：常驻手动搜索入口（Low/None 被动弹出之外，用户可随时主动打开面板；打开时自动预填歌名） -->
            <Button x:Name="SearchLyricsButton" Grid.Column="2" Content="🔍 搜索歌词"
                    Margin="12,0,0,0" Padding="10,4"
                    FontSize="12" Click="OnSearchLyricsClicked" />
            <Button x:Name="SettingsButton" Grid.Column="3" Content="⚙ 设置"
                    Margin="12,0,0,0" Padding="10,4"
                    FontSize="12" Click="OnOpenSettingsClicked" />
        </Grid>

        <!-- F9 手动搜索面板（TASK-401）：自动搜索 Low/None 时出现；绑定成功或用户取消后隐藏。最小可用，不做动画。 -->
        <Border x:Name="ManualSearchPanel" Grid.Row="8" Margin="0,10,0,0"
                Background="#161824" CornerRadius="8" Padding="12"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="自动搜索没有满意结果？手动搜索关键词并绑定歌词" FontSize="13"
                           Foreground="#9A9AA6" />
                <DockPanel Margin="0,8,0,0">
                    <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="搜索"
                            Padding="16,4" FontSize="13" Click="OnSearchClicked" />
                    <TextBox x:Name="SearchKeywordBox" Height="28" FontSize="13"
                             VerticalContentAlignment="Center" KeyDown="OnSearchKeywordKeyDown" />
                </DockPanel>
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <StackPanel x:Name="CandidateListPanel" />
                </ScrollViewer>
                <DockPanel Margin="0,8,0,0">
                    <Button x:Name="BindButton" Content="使用此歌词" IsEnabled="False"
                            Padding="12,4" FontSize="13" Click="OnBindClicked"
                            DockPanel.Dock="Left" />
                    <!-- TASK-503：清当前曲目缓存（正文/负缓存/用户绑定）后重新自动搜索 -->
                    <Button x:Name="CloseSearchButton" Content="取消"
                            Padding="12,4" FontSize="13" Click="OnCloseSearchClicked"
                            DockPanel.Dock="Right" />
                    <Button x:Name="ClearCacheButton" Content="清除缓存重搜"
                            Padding="12,4" FontSize="13" Click="OnClearCacheClicked"
                            DockPanel.Dock="Right" Margin="0,0,8,0" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
